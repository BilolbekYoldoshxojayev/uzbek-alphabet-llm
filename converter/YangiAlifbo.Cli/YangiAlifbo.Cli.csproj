<Project Sdk="Microsoft.NET.Sdk">

  <!-- Line-by-line batch converter for the research pipeline. Uses the full
       YangiAlifbo engine (lexicon + morphology + foreign filter + CNNs). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>false</InvariantGlobalization>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\external\yangicha-alifbo\src\YangiAlifbo.Core\YangiAlifbo.Core.csproj" />
  </ItemGroup>

</Project>
